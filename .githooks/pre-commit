#!/bin/sh
# Hai chốt chặn trước khi commit, đều chỉ liên quan tới Prisma:
#
#   1. schema.prisma đổi mà generated/ chưa sinh lại
#   2. DB production còn migration chưa apply
#
# Cả hai chỉ chạy khi commit có đụng tới prisma/ → commit khác không bị chậm.
# Bỏ qua khi thật sự cần:  git commit --no-verify

STAGED=$(git diff --cached --name-only)

# Commit không đụng prisma/ thì thôi.
if ! printf '%s' "$STAGED" | grep -q '^prisma/'; then
  exit 0
fi

# ---------------------------------------------------------------------------
# Chốt 1 — generated/ phải khớp với schema.prisma
#
# generated/ được COMMIT vào repo (xem .gitignore), vì Vercel cần module
# @/generated/prisma/client lúc build. Sửa schema mà quên sinh lại thì code
# production sẽ chạy trên client cũ và lỗi type hoặc lỗi runtime.
# ---------------------------------------------------------------------------
if printf '%s' "$STAGED" | grep -q '^prisma/schema\.prisma$'; then
  echo "prisma: schema đổi — kiểm tra generated/ có khớp không..."
  npx --no-install prisma generate >/dev/null 2>&1

  # So worktree với index: nếu generate vừa tạo ra thứ khác với cái đã stage
  # thì tức là người dùng chưa sinh lại (hoặc chưa add).
  DRIFT=$(git diff --name-only -- generated/; git ls-files --others --exclude-standard -- generated/)

  if [ -n "$DRIFT" ]; then
    echo ""
    echo "  ✖ COMMIT BỊ CHẶN — generated/ chưa khớp với schema.prisma."
    echo ""
    printf '%s\n' "$DRIFT" | sed 's/^/      /'
    echo ""
    echo "  Prisma Client vừa được sinh lại. Chỉ cần add rồi commit tiếp:"
    echo "      git add generated/"
    echo ""
    echo "  Nếu cố ý bỏ qua:  git commit --no-verify"
    echo ""
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Chốt 2 — DB production không được còn migration chưa apply
#
# `prisma migrate deploy` đã tách khỏi `npm run build` (xem CLAUDE.md), nên
# không còn gì tự động đưa schema lên production. Đây là cái nhắc duy nhất.
#
# Mất mạng hoặc thiếu .env thì CẢNH BÁO rồi vẫn cho commit — không cản người
# đang làm việc vì lý do hạ tầng ngoài tầm kiểm soát của họ.
# ---------------------------------------------------------------------------
if [ ! -f .env ]; then
  exit 0
fi

echo "prisma: kiểm tra migration trên DB production..."
OUTPUT=$(npx --no-install prisma migrate status 2>&1)
STATUS=$?

if printf '%s' "$OUTPUT" | grep -qi "not yet been applied"; then
  echo ""
  echo "  ✖ COMMIT BỊ CHẶN — DB production còn migration chưa chạy."
  echo ""
  printf '%s\n' "$OUTPUT" | grep -iA 20 "not yet been applied"
  echo ""
  echo "  Chạy trước khi commit:"
  echo "      npm run db:deploy"
  echo ""
  echo "  Nếu cố ý bỏ qua:  git commit --no-verify"
  echo ""
  exit 1
fi

if printf '%s' "$OUTPUT" | grep -qi "drift detected"; then
  echo ""
  echo "  ✖ COMMIT BỊ CHẶN — schema DB lệch so với lịch sử migration."
  echo ""
  printf '%s\n' "$OUTPUT" | tail -20
  echo ""
  echo "  Nếu cố ý bỏ qua:  git commit --no-verify"
  echo ""
  exit 1
fi

if [ $STATUS -ne 0 ]; then
  echo "  ⚠ Không kiểm tra được migration (mất mạng hoặc DB không truy cập được)."
  echo "    Vẫn cho commit. Nhớ chạy 'npm run db:status' trước khi deploy."
  exit 0
fi

echo "prisma: DB đã khớp với migration."
exit 0
