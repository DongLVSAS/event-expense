# Git hook là script sh — bắt buộc giữ LF.
# Nếu bị chuyển thành CRLF, shell trên Linux/macOS sẽ báo lỗi kiểu
# "bad interpreter: /bin/sh^M" và hook không chạy được.
.githooks/* text eol=lf

# Migration SQL cũng nên ổn định giữa các máy.
*.sql text eol=lf

# Prisma Client sinh tự động và được commit. Ép LF để diff không nhiễu
# chỉ vì máy Windows đổi kiểu xuống dòng, và đánh dấu là file sinh ra
# để GitHub thu gọn nó trong pull request.
generated/** text eol=lf
generated/** linguist-generated=true
