# Copy file này thành .env rồi điền connection string thật của Neon.
# KHÔNG commit .env (đã nằm trong .gitignore).
#
# Lấy ở Neon Dashboard -> project -> Connection string.
# Neon cho hai dạng, khác nhau đúng một chữ "-pooler" trong hostname:
#
#   pooled   : ...ep-xxx-pooler.<region>.aws.neon.tech...   <- DATABASE_URL
#   unpooled : ...ep-xxx.<region>.aws.neon.tech...          <- DIRECT_URL
#
# Trong Neon Dashboard, bỏ tick "Pooled connection" để thấy bản unpooled.

# App lúc chạy dùng bản POOLED — trên Vercel mỗi request là một serverless
# function, không giữ connection lâu, nên cần pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Prisma CLI (migrate / studio) dùng bản UNPOOLED — PgBouncer làm hỏng
# advisory lock và prepared statement mà migration cần.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
